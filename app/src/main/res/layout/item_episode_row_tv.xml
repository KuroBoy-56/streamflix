<?xml version="1.0" encoding="utf-8"?>
<!-- Episodio en lista, como en Roku: imagen a la izquierda; título, datos y sinopsis a la derecha.
     Mismos ids que item_episode_tv: se enlaza con ItemEpisodeTvBinding y la misma lógica. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="95dp"
    android:background="@drawable/bg_episode_row_tv"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/iv_episode_poster"
        android:layout_width="150dp"
        android:layout_height="85dp"
        android:layout_marginStart="5dp"
        android:background="@drawable/bg_item_episode_image_tv"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <ImageView
        android:id="@+id/iv_episode_watched_ribbon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_margin="4dp"
        android:elevation="2dp"
        android:src="@drawable/ic_watched"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_poster"
        app:layout_constraintTop_toTopOf="@id/iv_episode_poster"
        tools:ignore="ContentDescription" />

    <ProgressBar
        android:id="@+id/pb_episode_progress"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:backgroundTint="#99000000"
        android:progressTint="#E5E5E5"
        app:layout_constraintBottom_toBottomOf="@id/iv_episode_poster"
        app:layout_constraintEnd_toEndOf="@id/iv_episode_poster"
        app:layout_constraintStart_toStartOf="@id/iv_episode_poster" />

    <TextView
        android:id="@+id/tv_episode_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="15dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="15dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/iv_episode_poster"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Title" />

    <TextView
        android:id="@+id/tv_episode_info"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#B0B0B0"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@id/tv_episode_title"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_title"
        tools:text="Episodio 1" />

    <TextView
        android:id="@+id/tv_episode_released"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#B0B0B0"
        android:textSize="12sp"
        app:layout_constraintBaseline_toBaselineOf="@id/tv_episode_info"
        app:layout_constraintEnd_toEndOf="@id/tv_episode_title"
        app:layout_constraintStart_toEndOf="@id/tv_episode_info"
        tools:text="2024" />

    <TextView
        android:id="@+id/tv_episode_overview"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="#CFCFCF"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="@id/tv_episode_title"
        app:layout_constraintStart_toStartOf="@id/tv_episode_title"
        app:layout_constraintTop_toBottomOf="@id/tv_episode_info"
        tools:text="Overview" />

</androidx.constraintlayout.widget.ConstraintLayout>
