<?xml version="1.0" encoding="utf-8"?>
<!-- Inicio TV: póster grande arriba + una sola fila horizontal de portadas.
     Arriba/abajo reemplaza la fila visible por la siguiente categoría. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ImageView
        android:id="@+id/iv_hero_backdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="ContentDescription" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_scrim_start"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.75" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_hero_scrim_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.65"
        app:layout_constraintStart_toStartOf="parent" />

    <LinearLayout
        android:id="@+id/ll_hero_info"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="70dp"
        android:layout_marginTop="36dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="0.52">

        <TextView
            android:id="@+id/tv_hero_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:textAllCaps="true"
            android:textColor="?attr/colorAccent"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Tendencias" />

        <TextView
            android:id="@+id/tv_hero_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#CC000000"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:textColor="#FFFFFF"
            android:textSize="34sp"
            android:textStyle="bold"
            tools:text="Title" />

        <LinearLayout
            android:id="@+id/ll_hero_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hero_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                tools:text="Película" />

            <TextView
                android:id="@+id/tv_hero_year"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="#E6FFFFFF"
                android:textSize="14sp"
                tools:text="2026" />

            <TextView
                android:id="@+id/tv_hero_quality"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:background="@drawable/bg_hero_chip"
                android:textAllCaps="true"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="HD" />

            <TextView
                android:id="@+id/tv_hero_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:textColor="#FFD54F"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="★ 7.8" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_hero_overview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            android:maxLines="3"
            android:textColor="#D9FFFFFF"
            android:textSize="14sp"
            tools:text="Overview" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_hero_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="18dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="70dp"
            android:layout_marginEnd="70dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_hero_row_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="Categoría" />

            <TextView
                android:id="@+id/tv_hero_row_position"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#99FFFFFF"
                android:textSize="13sp"
                tools:text="2 / 8" />
        </LinearLayout>

        <!-- Mantiene el foco dentro del inicio mientras se reemplaza la fila (evita que salte al menú). -->
        <View
            android:id="@+id/v_hero_focus_anchor"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <androidx.leanback.widget.HorizontalGridView
            android:id="@+id/hgv_hero_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="70dp"
            android:paddingTop="8dp"
            android:paddingEnd="70dp"
            android:paddingBottom="8dp"
            app:focusOutEnd="true"
            app:focusOutFront="true" />

        <TextView
            android:id="@+id/tv_hero_row_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="70dp"
            android:layout_marginTop="6dp"
            android:alpha="0.6"
            android:drawablePadding="6dp"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            tools:text="▼  Siguiente: Acción" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
