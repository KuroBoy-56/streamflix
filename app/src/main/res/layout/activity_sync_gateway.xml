<?xml version="1.0" encoding="utf-8"?>
<!-- Login con el mismo diseño del canal de Roku: tarjeta, bienvenida y campos redondeados. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/roku_background">

    <ImageView
        android:id="@+id/bgGateway"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:alpha="0.6"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <!-- ⚡️ EL SCROLLVIEW EVITA QUE SE CORTE POR LA MITAD EN TV -->
    <ScrollView
        android:id="@+id/loginScroll"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintWidth_max="400dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/loginContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="26dp"
            android:paddingBottom="24dp"
            android:background="@drawable/bg_login_card">

            <ImageView
                android:id="@+id/logoGateway"
                android:layout_width="match_parent"
                android:layout_height="84dp"
                android:layout_marginBottom="14dp"
                android:visibility="gone"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Bienvenido"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="22dp"
                android:gravity="center"
                android:text="Inicia sesión para continuar"
                android:textColor="#B4B9C8"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/inputAlpha"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_field"
                android:gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="textNoSuggestions"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:hint="Usuario"
                android:textColorHint="@color/login_hint_text" />

            <EditText
                android:id="@+id/inputBeta"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_field"
                android:gravity="center_vertical"
                android:textColor="#FFFFFF"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:inputType="textPassword"
                android:layout_marginBottom="12dp"
                android:focusable="true"
                android:hint="Contraseña"
                android:textColorHint="@color/login_hint_text" />

            <Button
                android:id="@+id/btnSync"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_login_button"
                android:gravity="center"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:stateListAnimator="@null"
                android:text="Iniciar sesión"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:focusable="true" />

            <ProgressBar
                android:id="@+id/progressSync"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:visibility="gone"
                android:indeterminateTint="@color/login_focus"/>

            <TextView
                android:id="@+id/txtStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#FF5252"
                android:textStyle="bold"
                android:visibility="gone"/>

            <!-- MAC del equipo (ANDROID_ID en pares, igual que la registra el panel) -->
            <TextView
                android:id="@+id/txtDeviceMac"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_login_chip"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textColor="#E5E5E5"
                android:textIsSelectable="true"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Campos vacíos: entra con la MAC vinculada"
                android:textColor="#8A8FA0"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
