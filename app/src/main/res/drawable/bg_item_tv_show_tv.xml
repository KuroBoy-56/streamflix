<?xml version="1.0" encoding="utf-8"?>
<!-- Estilo Roku: aro rojo redondeado al enfocar. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_activated="true">
        <layer-list>
            <item android:bottom="-4dp" android:left="-4dp" android:right="-4dp" android:top="-4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <solid android:color="#2200E5FF" />
                    <stroke android:width="5dp" android:color="@color/favorite_selected" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:state_focused="true">
        <layer-list>
            <item android:bottom="-4dp" android:left="-4dp" android:right="-4dp" android:top="-4dp">
                <shape android:shape="rectangle">
                    <corners android:radius="10dp" />
                    <stroke android:width="4dp" android:color="@color/roku_red" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item>
        <shape android:shape="rectangle"></shape>
    </item>

</selector>
