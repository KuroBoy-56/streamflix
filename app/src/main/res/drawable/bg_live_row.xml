<?xml version="1.0" encoding="utf-8"?>
<!-- Fila de carpeta/canal en "En Vivo" (estilo TiviMate): enfocada, elegida o normal. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android" android:exitFadeDuration="150">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@color/roku_red" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#33FFFFFF" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#2A2D3A" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
