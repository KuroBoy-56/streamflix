<?xml version="1.0" encoding="utf-8"?>
<!-- Campo del login: rojo al enfocar, gris azulado en reposo (como Roku). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/roku_red" />
        </shape>
    </item>
    <item>
        <shape>
            <corners android:radius="12dp" />
            <solid android:color="@color/roku_field" />
            <stroke android:width="1dp" android:color="#2E3242" />
        </shape>
    </item>
</selector>
