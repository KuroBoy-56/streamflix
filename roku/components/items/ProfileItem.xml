<?xml version="1.0" encoding="utf-8"?>
<!-- Perfil en "¿Quién está viendo?": avatar, nombre y candado si tiene PIN. -->
<component name="ProfileItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent"/>
    <field id="focusPercent" type="float" onChange="onFocusPercent"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/items/ProfileItem.brs"/>
  <children>
    <Rectangle id="ring" width="232" height="232" color="0xFFFFFF00"/>
    <Rectangle translation="[8,8]" width="216" height="216" color="0x2A2E3DFF"/>
    <Label id="plus" translation="[8,8]" width="216" height="216" horizAlign="center" vertAlign="center" font="font:LargeBoldSystemFont" color="0xFFFFFFFF"/>
    <Poster id="avatar" translation="[8,8]" width="216" height="216" loadDisplayMode="scaleToZoom"/>
    <Label id="name" translation="[0,248]" width="232" horizAlign="center" font="font:MediumSystemFont" color="0xBBBBBBFF"/>
    <Label id="lock" translation="[0,286]" width="232" horizAlign="center" font="font:SmallestSystemFont" color="0x8A8A8AFF"/>
  </children>
</component>
