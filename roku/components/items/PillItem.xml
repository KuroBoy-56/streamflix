<?xml version="1.0" encoding="utf-8"?>
<!-- Botón tipo píldora para listas y cuadrículas de opciones (login, diálogos, ficha). -->
<component name="PillItem" extends="Group">
  <interface>
    <field id="itemContent" type="node" onChange="onContent"/>
    <field id="width" type="float" onChange="onLayout"/>
    <field id="height" type="float" onChange="onLayout"/>
    <field id="focusPercent" type="float" onChange="onFocus"/>
    <field id="gridHasFocus" type="boolean" onChange="onFocus"/>
    <field id="listHasFocus" type="boolean" onChange="onFocus"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/components/items/PillItem.brs"/>
  <children>
    <Poster id="idle" uri="pkg:/images/field.9.png"/>
    <Poster id="focus" uri="pkg:/images/field_focus.9.png" opacity="0"/>
    <Label id="label" vertAlign="center" font="font:MediumSystemFont" color="0xD8DCE8FF"/>
  </children>
</component>
