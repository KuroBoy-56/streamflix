    <field id="params" type="assocarray" onChange="onParams"/>
    <field id="action" type="assocarray" alwaysNotify="true"/>
    <field id="result" type="assocarray" alwaysNotify="true"/>
    <field id="resumed" type="boolean" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Screen.brs"/>
  <script type="text/brightscript" uri="pkg:/components/screens/NoteScreen.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000B8"/>
    <Poster translation="[410,150]" width="1100" height="780" uri="pkg:/images/card.9.png"/>
    <Rectangle translation="[470,152]" width="980" height="6" color="0xE50914FF"/>
    <Poster id="logo" translation="[860,200]" width="200" height="90" loadDisplayMode="scaleToFit"/>
    <Label id="title" translation="[470,310]" width="980" horizAlign="center" font="font:LargeBoldSystemFont" color="0xFFFFFFFF"/>
    <ScrollableText id="text" translation="[490,390]" width="940" height="400" horizAlign="center" font="font:MediumSystemFont" color="0xE5E5E5FF"/>
    <Poster translation="[810,820]" width="300" height="76" uri="pkg:/images/field_focus.9.png"/>
    <Label translation="[810,820]" width="300" height="76" horizAlign="center" vertAlign="center" font="font:MediumBoldSystemFont" color="0xFFFFFFFF" text="Entendido"/>
