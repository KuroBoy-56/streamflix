<?xml version="1.0" encoding="utf-8"?>
<!-- Texto a pantalla completa: nota del panel en Ajustes y aviso de vencimiento. -->
<component name="NoteScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams"/>
    <field id="action" type="assocarray" alwaysNotify="true"/>
    <field id="result" type="assocarray" alwaysNotify="true"/>
    <field id="resumed" type="boolean" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Screen.brs"/>
  <script type="text/brightscript" uri="pkg:/components/screens/NoteScreen.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x141414FF"/>
    <Poster id="logo" translation="[870,50]" width="180" height="64" loadDisplayMode="scaleToFit"/>
    <Label id="title" translation="[160,140]" width="1600" horizAlign="center" font="font:LargeBoldSystemFont" color="0xFFFFFFFF"/>
    <ScrollableText id="text" translation="[260,230]" width="1400" height="700" horizAlign="center" font="font:MediumSystemFont" color="0xE5E5E5FF"/>
    <Label translation="[0,980]" width="1920" horizAlign="center" font="font:SmallSystemFont" color="0x9A9A9AFF" text="Pulsa Atrás u OK para cerrar"/>
  </children>
</component>
