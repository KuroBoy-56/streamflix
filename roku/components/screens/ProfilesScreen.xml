<?xml version="1.0" encoding="utf-8"?>
<!-- "¿Quién está viendo?" (ProfilesActivity): elegir, crear, editar, PIN y eliminar perfiles. -->
<component name="ProfilesScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams"/>
    <field id="action" type="assocarray" alwaysNotify="true"/>
    <field id="result" type="assocarray" alwaysNotify="true" onChange="onResult"/>
    <field id="resumed" type="boolean" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Tasks.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Screen.brs"/>
  <script type="text/brightscript" uri="pkg:/components/screens/ProfilesScreen.brs"/>
  <children>
    <Poster id="logo" translation="[860,60]" width="200" height="80" loadDisplayMode="scaleToFit"/>
    <Label id="title" translation="[0,220]" width="1920" horizAlign="center" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" text="¿Quién está viendo?"/>
    <MarkupGrid id="grid" itemComponentName="ProfileItem" itemSize="[232,320]" itemSpacing="[48,0]" numRows="1" numColumns="6" translation="[0,380]" drawFocusFeedback="false"/>
    <Label id="status" translation="[0,760]" width="1920" horizAlign="center" font="font:MediumSystemFont" color="0xFF5252FF"/>
    <Label id="hint" translation="[0,960]" width="1920" horizAlign="center" font="font:SmallSystemFont" color="0x8A8A8AFF" text="OK: entrar   ✱: editar perfil"/>
  </children>
</component>
