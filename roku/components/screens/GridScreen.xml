<?xml version="1.0" encoding="utf-8"?>
<!-- Cuadrícula: Favoritos (FavoritesTvFragment) y filmografía de una persona (PeopleTvFragment). -->
<component name="GridScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams"/>
    <field id="action" type="assocarray" alwaysNotify="true"/>
    <field id="result" type="assocarray" alwaysNotify="true"/>
    <field id="resumed" type="boolean" alwaysNotify="true" onChange="onResumed"/>
    <field id="active" type="boolean" onChange="onResumed"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Tasks.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Nodes.brs"/>
  <script type="text/brightscript" uri="pkg:/source/UserData.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Screen.brs"/>
  <script type="text/brightscript" uri="pkg:/components/screens/GridScreen.brs"/>
  <children>
    <Rectangle id="bg" width="1920" height="1080" color="0x0F111AFF" visible="false"/>
    <Poster id="photo" translation="[130,60]" width="150" height="225" loadDisplayMode="scaleToZoom"/>
    <Label id="title" translation="[130,60]" width="1650" font="font:LargeBoldSystemFont" color="0xFFFFFFFF"/>
    <Label id="overview" translation="[310,130]" width="1480" height="150" wrap="true" maxLines="4" font="font:SmallSystemFont" color="0xCFCFCFFF"/>
    <MarkupGrid id="grid" translation="[130,180]" itemComponentName="PosterItem" itemSize="[200,340]" itemSpacing="[22,30]" numColumns="8" numRows="3"/>
    <BusySpinner id="spinner" translation="[912,500]" visible="false"/>
    <Label id="message" translation="[200,500]" width="1520" horizAlign="center" wrap="true" font="font:MediumSystemFont" color="0xBBBBBBFF" visible="false"/>
  </children>
</component>
