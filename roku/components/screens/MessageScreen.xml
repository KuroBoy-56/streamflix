<?xml version="1.0" encoding="utf-8"?>
<!-- Diálogo: título, mensaje y botones. Responde con { type: "result", tag, index }. -->
<component name="MessageScreen" extends="Group">
  <interface>
    <field id="params" type="assocarray" onChange="onParams"/>
    <field id="action" type="assocarray" alwaysNotify="true"/>
    <field id="result" type="assocarray" alwaysNotify="true"/>
    <field id="resumed" type="boolean" alwaysNotify="true"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Screen.brs"/>
  <script type="text/brightscript" uri="pkg:/components/screens/MessageScreen.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x000000CC"/>
    <Rectangle id="panel" width="1000" height="560" translation="[460,260]" color="0x1A1D29FF">
      <Rectangle width="1000" height="6" color="0xE50914FF"/>
      <Label id="title" translation="[60,50]" width="880" font="font:LargeBoldSystemFont" color="0xFFFFFFFF"/>
      <Label id="message" translation="[60,130]" width="880" height="250" wrap="true" font="font:MediumSystemFont" color="0xE5E5E5FF"/>
      <ButtonGroup id="buttons" translation="[60,400]" layoutDirection="horiz" itemSpacings="[20]" minWidth="250"/>
    </Rectangle>
  </children>
</component>
