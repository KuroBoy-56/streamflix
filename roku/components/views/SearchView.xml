<?xml version="1.0" encoding="utf-8"?>
<!-- Buscar (SearchTvFragment): películas, series y personas. -->
<component name="SearchView" extends="Group">
  <interface>
    <field id="params" type="assocarray"/>
    <field id="action" type="assocarray" alwaysNotify="true"/>
    <field id="result" type="assocarray" alwaysNotify="true"/>
    <field id="resumed" type="boolean" alwaysNotify="true"/>
    <field id="active" type="boolean"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Tasks.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Nodes.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Screen.brs"/>
  <script type="text/brightscript" uri="pkg:/components/views/SearchView.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x0F111AE6"/>
    <Label translation="[130,60]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" text="Buscar"/>
    <MiniKeyboard id="keyboard" translation="[130,160]"/>
    <MarkupGrid id="grid" translation="[760,160]" itemComponentName="PosterItem" drawFocusFeedback="false" itemSize="[190,330]" itemSpacing="[20,30]" numColumns="5" numRows="2"/>
    <Label id="message" translation="[760,400]" width="1050" horizAlign="center" wrap="true" font="font:MediumSystemFont" color="0xBBBBBBFF" text="Escribe el nombre de una película, serie o actor."/>
    <Timer id="debounce" duration="0.8" repeat="false"/>
  </children>
</component>
