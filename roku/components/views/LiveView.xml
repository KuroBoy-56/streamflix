<?xml version="1.0" encoding="utf-8"?>
<!-- En Vivo estilo TiviMate (LiveTvFragment): carpetas | canales | vista previa con guía. -->
<component name="LiveView" extends="Group">
  <interface>
    <field id="params" type="assocarray"/>
    <field id="action" type="assocarray" alwaysNotify="true"/>
    <field id="result" type="assocarray" alwaysNotify="true"/>
    <field id="resumed" type="boolean" alwaysNotify="true"/>
    <field id="active" type="boolean" onChange="onActive"/>
  </interface>
  <script type="text/brightscript" uri="pkg:/source/Utils.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Tasks.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Playback.brs"/>
  <script type="text/brightscript" uri="pkg:/source/Screen.brs"/>
  <script type="text/brightscript" uri="pkg:/source/CjkText.brs"/>
  <script type="text/brightscript" uri="pkg:/components/views/LiveView.brs"/>
  <children>
    <Rectangle width="1920" height="1080" color="0x0F111AF0"/>
    <Label id="heading" translation="[130,50]" width="900" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" text="En Vivo"/>
    <MarkupGrid id="modes" translation="[130,140]" itemComponentName="PillItem" drawFocusFeedback="false" numRows="1" numColumns="2" itemSize="[184,56]" itemSpacing="[12,0]" visible="false"/>
    <MarkupList id="folders" translation="[130,150]" itemSize="[380,64]" itemSpacing="[0,4]" numRows="13" itemComponentName="MenuItem" drawFocusFeedback="false" vertFocusAnimationStyle="floatingFocus"/>
    <MarkupList id="channels" translation="[540,150]" itemComponentName="ChannelItem" itemSize="[620,84]" itemSpacing="[0,4]" numRows="10" drawFocusFeedback="false"/>
    <Rectangle translation="[1190,150]" width="640" height="360" color="0x000000FF"/>
    <Video id="preview" translation="[1190,150]" width="640" height="360" enableUI="false"/>
    <Label id="previewHint" translation="[1220,280]" width="580" height="100" horizAlign="center" vertAlign="center" wrap="true" font="font:SmallSystemFont" color="0x8A8A8AFF" text="OK: vista previa aquí&#10;OK otra vez o ▶: pantalla completa"/>
    <Label id="channelName" translation="[1190,530]" width="640" font="font:MediumBoldSystemFont" color="0xFFFFFFFF"/>
    <Label id="channelMeta" translation="[1190,575]" width="640" font="font:SmallestSystemFont" color="0xB0B0B0FF"/>
    <Label id="nowTitle" translation="[1190,625]" width="640" font="font:SmallBoldSystemFont" color="0xFFFFFFFF"/>
    <Rectangle id="nowBarBg" translation="[1190,668]" width="640" height="6" color="0xFFFFFF33" visible="false"/>
    <Rectangle id="nowBar" translation="[1190,668]" width="0" height="6" color="0xE5E5E5FF" visible="false"/>
    <Label id="nowDesc" translation="[1190,690]" width="640" height="150" wrap="true" maxLines="4" font="font:SmallestSystemFont" color="0xCFCFCFFF"/>
    <Label id="nextTitle" translation="[1190,860]" width="640" font="font:SmallestSystemFont" color="0xB0B0B0FF"/>
    <BusySpinner id="spinner" translation="[800,480]" visible="false"/>
    <Label id="message" translation="[540,480]" width="1240" horizAlign="center" wrap="true" font="font:MediumSystemFont" color="0xBBBBBBFF"/>
  </children>
</component>
